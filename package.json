{
  "name": "@argus/monitor",
  "version": "0.1.0",
  "description": "Framework-independent browser event monitoring SDK",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/identificacao-de-elementos.md",
    "examples",
    "src/transport/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:distribution": "node tests/distribution/package.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "example": "npm run build && node scripts/serve-example.mjs",
    "example:shopping": "npm run build && node scripts/serve-shopping.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.89.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
