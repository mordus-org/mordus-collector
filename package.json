{
  "name": "@argus/monitor",
  "version": "0.1.0",
  "description": "Framework-independent browser event monitoring SDK",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/identificacao-de-elementos.md",
    "examples",
    "src/transport/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:distribution": "node tests/distribution/package.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "npm run build && node scripts/serve-example.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
